<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ProjectGuid>{4F19469B-3352-4D93-89E2-4B79FD7086A6}</ProjectGuid>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../../external/WebFormsForCore.AjaxControlToolkit/AjaxKey.snk</AssemblyOriginatorKeyFile>

        <PackageId>webForCore.AjaxControlToolkit.HtmlEditor.Sanitizer</PackageId>
        <Title>AjaxControlToolkit</Title>
        <Product>AjaxControlToolkit</Product>
        <Description>AjaxControlToolkit for WebFormsForCore</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    </ItemGroup>
    <ItemGroup Condition="$(TargetFramework) != 'net48'">
        <PackageReference Include="webForCore.Web" Version="$(WebForCoreVersion)" />
        <PackageReference Include="webForCore.Configuration" Version="$(WebForCoreVersion)" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AjaxControlToolkit\AjaxControlToolkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <Target Name="ChangeAliasesOfNugetRefs" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <!-- Do not import System.Configuration.ConfigurationManager version 8 -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Configuration.ConfigurationManager' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)system\.configuration\.configurationmanager[\\/]'))" />
            <!-- Do not import System.Web from dotnet -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'[\\/]\.?dotnet[\\/]'))" />
            <!-- Do not import System.Drawing from dotnet -->
            <!--<ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Drawing' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'[\\/]\.?dotnet[\\/]'))" />-->
        </ItemGroup>
    </Target>


  <!-- The toolkit's code, from the external/WebFormsForCore.AjaxControlToolkit submodule (xforcore/webForCore#61). -->
  <ItemGroup>
    <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/AjaxControlToolkit.HtmlEditor.Sanitizer/DefaultHtmlSanitizer.cs" Link="DefaultHtmlSanitizer.cs" />
    <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/AjaxControlToolkit.HtmlEditor.Sanitizer/HtmlAttributeWrapper.cs" Link="HtmlAttributeWrapper.cs" />
    <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/AjaxControlToolkit.HtmlEditor.Sanitizer/HtmlNodeWrapper.cs" Link="HtmlNodeWrapper.cs" />
    <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/AjaxControlToolkit.HtmlEditor.Sanitizer/IHtmlAttribute.cs" Link="IHtmlAttribute.cs" />
    <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/AjaxControlToolkit.HtmlEditor.Sanitizer/IHtmlNode.cs" Link="IHtmlNode.cs" />
    <Compile Include="../../../external/WebFormsForCore.AjaxControlToolkit/AjaxControlToolkit.HtmlEditor.Sanitizer/Properties/AssemblyInfo.cs" Link="Properties/AssemblyInfo.cs" />
  </ItemGroup>
</Project>
