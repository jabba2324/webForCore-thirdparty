<?xml version="1.0" encoding="utf-8"?>
<!-- webForCore's packages come from its GitHub release (tools/fetch-webforcore.sh puts them in packages/webforcore);
     everything else from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="webforcore" value="packages/webforcore" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="webforcore">
      <package pattern="webForCore" />
      <package pattern="webForCore.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
